# Krant AR - Apache configuratie
RewriteEngine On

# PHP upload limits (valt terug op .user.ini bij FastCGI hosting)
php_value upload_max_filesize 64M
php_value post_max_size 128M
php_value max_execution_time 300

# API calls routeren naar api.php
RewriteRule ^api/(.*)$ api.php/$1 [L,QSA]

# Beveiliging: gevoelige files blokkeren
<FilesMatch "(\.db|\.db3|\.sqlite|login_attempts\.json|\.md|\.bak)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# CORS voor AR resources (MindAR laadt .mind + layers via XHR/WebGL)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|mind)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cross-Origin-Resource-Policy "cross-origin"
    </FilesMatch>

    # index.html altijd vers; de rest is immutable gecached (?v= versies via API)
    <FilesMatch "^(index\.html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Static assets: lang cachen (URLs krijgen ?v= bij wijziging)
    <FilesMatch "\.(css|js|jpg|jpeg|png|webp|gif|svg|mind)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Geen gzip voor binaire .mind files (corruptie-gevoelig)
<IfModule mod_deflate.c>
    SetEnvIfNoCase Request_URI "\.mind$" no-gzip=1
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>
